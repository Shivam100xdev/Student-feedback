# Database (optional - Google sign-in still works without it; college logins fall back to COLLEGE_ACCOUNTS)
DATABASE_URL=postgresql://user:password@localhost:5432/feedback_db

# Google OAuth (created in Google Cloud Console - a personal Gmail Google account is fine)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft / college Azure AD sign-in (optional, button is disabled until set)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Auth.js
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# College logins used when no database row exists.
# passwordHash = scrypt:<saltHex>:<hashHex> from: npm run auth:hash-password -- "YourPassword"
COLLEGE_ACCOUNTS=[{"login":"20231ST0024","email":"20231st0024@presidencyuniversity.edu","name":"Aarav Sharma","role":"STUDENT","passwordHash":"replace-me"}]

# Public links shown on the sign-in page
NEXT_PUBLIC_APP_DOWNLOAD_URL=https://ams.presidencyuniversity.edu/app

# Optional integrations
REDIS_URL=
QSTASH_TOKEN=
SERVER_SECRET=
ENCRYPTION_KEY=
